type Query {
  # PATIENT: ignora patientId e usa o sub do token.
  # DOCTOR/NURSE: patientId obrigatório (filtro do paciente consultado).
  appointments(
    patientId: ID
    futureOnly: Boolean = false
    # page começa em 1
    page: Int!
    size: Int!
  ): AppointmentHistory!
}

type AppointmentHistory {
  projectionFreshness: String
  appointments: [AppointmentProjection!]!
  page: Int!
  size: Int!
  totalElements: Int!
  totalPages: Int!
}

type AppointmentProjection {
  appointmentId: ID!
  patientId: ID!
  doctorId: ID!
  scheduledAt: String!
  status: AppointmentStatus!
  fitIn: Boolean!
  fitInReason: String
  patientName: String!
  doctorName: String!
  doctorSpecialty: String!
  cancelledAt: String
  completedAt: String
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}
