# Copie para .env e ajuste o que precisar: cp .env.example .env
#
# Nada aqui é obrigatório. Todo valor tem default no docker-compose.yml, então
# `docker compose up` funciona num clone limpo, sem .env nenhum. O .env existe
# para sobrescrever, não para habilitar.
#
# Deixar a chave com valor vazio equivale a não declará-la: o Compose usa a
# forma ${VAR:-default}, que cai no default tanto para variável ausente quanto
# para variável vazia. Por isso este arquivo pode ser copiado como está.
#
# O .env é ignorado pelo git; este arquivo, não. Quando um valor passar a ser
# segredo de verdade, ele entra aqui apenas como nome e placeholder.
#
# A lista abaixo é completa: são todas as variáveis que o docker-compose.yml
# substitui. Nenhuma outra tem efeito pelo .env.

# --- Credenciais dos bancos ---------------------------------------------------
# Valem para os quatro Postgres. O nome de cada banco não é configurável: é
# estrutural, um por serviço (ADR-0008).
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Portas publicadas no host ------------------------------------------------
# São as únicas três que saem para o host; os bancos e o broker não publicam
# porta nenhuma. Mude se já houver algo ocupando a porta nesta máquina.
GATEWAY_PORT=
KAFBAT_UI_PORT=
MAILPIT_UI_PORT=

# --- URLs JDBC dos bancos -----------------------------------------------------
# Apontam para os hostnames da rede do Compose. Existem como variável para o
# caso de apontar um serviço para um Postgres externo; no fluxo normal do
# `compose up`, não se mexe.
IDENTITY_DB_URL=
SCHEDULING_DB_URL=
HISTORY_DB_URL=
NOTIFICATION_DB_URL=

# --- Kafka --------------------------------------------------------------------
# Broker usado pelos produtores e consumidores. O Debezium Connect tem a própria
# configuração no serviço kafka-connect e não lê esta variável.
KAFKA_BOOTSTRAP_SERVERS=

# --- Autenticação -------------------------------------------------------------
# JWKS do identity, de onde os resource servers buscam a chave pública para
# validar o JWT offline (ADR-0013). Consumido por gateway e history.
IDENTITY_JWKS_URI=

# --- Gateway: destinos do proxy e da saúde agregada ---------------------------
# O gateway é a porta única (ADR-0014): encaminha as rotas dos quatro serviços e
# consolida a saúde deles em GET /health/system. As quatro URLs são os nomes de
# serviço da rede do Compose e quase nunca precisam mudar; existem para apontar
# o gateway a um serviço rodando fora da rede, durante depuração.
IDENTITY_URL=
SCHEDULING_URL=
HISTORY_URL=
NOTIFICATION_URL=

# Prazo de leitura do proxy ao encaminhar para um serviço. Aceita duração do
# Spring, como 5s ou 800ms. Vencido o prazo, o gateway responde 504; falha de
# conexão responde 503. Aumente se a máquina que avalia for lenta.
GATEWAY_PROXY_READ_TIMEOUT=

# --- Porta interna das aplicações ---------------------------------------------
# ⚠ Não mexa sem mudar o resto junto. O Compose entrega esta variável aos quatro
# serviços, mas só identity e history a leem: scheduling e notification têm 8080
# fixo no application.yml. E as URLs acima, mais o IDENTITY_JWKS_URI, apontam
# para :8080. Trocar só esta variável tira identity e history do lugar onde o
# gateway procura por eles.
SERVER_PORT=

# --- Notification: e-mail e disparo do lembrete -------------------------------
# O notification é o único serviço que fala SMTP. No `compose up` ele entrega em
# `mailpit:1025`, e a caixa é a UI em :8025 (MAILPIT_UI_PORT). Apontar para um
# SMTP real só faria sentido fora deste ambiente.
MAIL_HOST=
MAIL_PORT=

# Quanto antes da consulta o lembrete sai. Duração do Spring: PT24H, PT2H, PT30M.
# Consulta marcada dentro desta janela não gera lembrete — não há antecedência
# mínima no agendamento (ADR-0010), e o disparo que já venceu não é criado.
REMINDER_LEAD_TIME=

# Intervalo da varredura que entrega confirmação e lembrete vencidos. Baixo de
# propósito: a confirmação sai nesta varredura, e quem avalia não espera 24h.
NOTIFICATION_SWEEP_INTERVAL=

# Teto de tentativas por notificação e tamanho do lote de cada varredura.
# Atingido o teto, a linha para de ser varrida, continua PENDING e o abandono é
# registrado em ERROR — projeção atrasada e projeção abandonada não podem ter a
# mesma aparência.
NOTIFICATION_MAX_ATTEMPTS=
NOTIFICATION_DISPATCH_BATCH_SIZE=

# Remetente dos e-mails e fuso usado para escrever a data no corpo da mensagem.
# O fuso é só apresentação: no banco e nos eventos, todo instante é UTC.
NOTIFICATION_FROM_ADDRESS=
NOTIFICATION_DISPLAY_ZONE=
