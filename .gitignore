# --- Build -------------------------------------------------------------------
target/
build/
!.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/maven-wrapper.jar
pom.xml.versionsBackup
pom.xml.releaseBackup
pom.xml.tag
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# --- Java --------------------------------------------------------------------
*.class
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# --- Segredos e chaves --------------------------------------------------------
# O identity assina JWT com par de chaves (ADR-0013). A chave PRIVADA nunca
# entra no repositório; só a pública, servida via JWKS, é pública por definição.
*.pem
*.p12
*.jks
*.keystore
*-private.key
*.key
!*-public.key
.env
.env.*
!.env.example
secrets/

# --- Dados de container -------------------------------------------------------
# Volumes de Postgres/Kafka montados como bind mount durante o desenvolvimento.
data/
services/*/data/
pgdata/

# --- Cobertura, análise e relatórios -----------------------------------------
.sonar/
.scannerwork/
*.exec
jacoco.exec
surefire-reports/
failsafe-reports/

# --- IDE ---------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
nbproject/
nb-configuration.xml
*.sublime-workspace

# --- Compose local ------------------------------------------------------------
# O Compose carrega este arquivo automaticamente, sem flag. Ele existe para
# sobreposição local (publicar a porta de um serviço para depurar, por exemplo),
# e o ADR-0014 prevê esse uso. Não entra no repositório: o que vale para todos
# está no docker-compose.yml.
docker-compose.override.yml

# --- Ferramentas locais de agente --------------------------------------------
.claude/settings.local.json
.maestri/

# --- Sistema operacional ------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Logs --------------------------------------------------------------------
*.log
logs/
