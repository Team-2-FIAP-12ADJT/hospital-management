{
  "info": {
    "_postman_id": "bca356f3-b01c-48fb-918b-351ab01857fe",
    "name": "hospital-management",
    "description": "Login (ADR-0013) e cadastro de médico (ADR-0015). Aponta para o gateway, porta única (ADR-0014). Usa a conta semeada pela V1__initial_schema_and_seeded_accounts.sql (Dra. Helena Prado, papel DOCTOR, CPF 39053344705 / medico@123). As três contas semeadas estão documentadas no README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "14270995",
    "_collection_link": "https://go.postman.co/collection/14270995-bca356f3-b01c-48fb-918b-351ab01857fe?source=collection_link"
  },
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login (conta de teste)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"accessToken presente\", () => pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty);",
                  "",
                  "pm.collectionVariables.set(\"accessToken\", body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{testDoctorCpf}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{testDoctorPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "HTTP Basic com CPF como identificador de login (ADR-0013). Devolve o JWT RS256 usado nas rotas protegidas."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Cadastrar médico",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"id presente\", () => pm.expect(pm.response.json().id).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"taxIdentifier\": \"98765432100\",\n    \"crm\": \"CRM-SP 654321\",\n    \"specialty\": \"Neurologia\",\n    \"name\": \"Dr. João Mendes\",\n    \"email\": \"joao.mendes@hospital.local\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            },
            "description": "Exige token de um usuário com papel DOCTOR (decisão do projeto, não documentada nos ADRs). Grava o Doctor e publica DoctorRegistered na mesma transação (ADR-0012)."
          },
          "response": []
        }
      ]
    },
