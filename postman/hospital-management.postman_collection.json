{
	"info": {
		"name": "hospital-management",
		"description": "Login (ADR-0013), cadastro de médico (ADR-0015) e ativação de conta (ticket 23). Aponta para o gateway, porta única (ADR-0014). A pasta Ativação extrai o token pela API do Mailpit (porta 8025). A conta semeada Dra. Helena Prado (CPF 39053344705 / medico@123) serve o login das rotas autenticadas. Newman: --delay-request 1000 para a espera do e-mail.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080", "type": "string", "description": "gateway, porta única de entrada (ADR-0014)." },
		{ "key": "mailpitUrl", "value": "http://localhost:8025", "type": "string", "description": "API HTTP do Mailpit." },
		{ "key": "testDoctorCpf", "value": "39053344705", "type": "string", "description": "Conta semeada pela V1 (papel DOCTOR, Dra. Helena Prado)." },
		{ "key": "testDoctorPassword", "value": "medico@123", "type": "string" },
		{ "key": "accessToken", "value": "", "type": "string" },
		{ "key": "activationCpf", "value": "", "type": "string" },
		{ "key": "activationEmail", "value": "", "type": "string" },
		{ "key": "activationPassword", "value": "ativa@123", "type": "string" },
		{ "key": "activationToken", "value": "", "type": "string" },
						{ "key": "mailpitMessageId", "value": "", "type": "string" },
		{ "key": "mailpitAttempts", "value": "0", "type": "string" }
	],
	"item": [
		{
			"name": "Autenticação",
			"item": [
				{
					"name": "Login (conta de teste)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "{{testDoctorCpf}}", "type": "string" },
								{ "key": "password", "value": "{{testDoctorPassword}}", "type": "string" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [ "{{baseUrl}}" ],
							"path": [ "auth", "login" ]
						},
						"description": "HTTP Basic com CPF como identificador de login (ADR-0013). Devolve o JWT RS256 usado nas rotas protegidas."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test(\"accessToken presente\", () => pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty);",
									"",
									"pm.collectionVariables.set(\"accessToken\", body.accessToken);"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Ativação de conta",
			"description": "Ciclo do ticket 23: cadastro público → e-mail no Mailpit → POST /auth/activate → login com JWT. Exige compose no ar (gateway, scheduling, identity, notification, Kafka, Debezium, Mailpit). No Newman use --delay-request 1000.",
			"item": [
				{
					"name": "Cadastrar paciente",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const cpf = String(90000000000 + Math.floor(Math.random() * 999999999)).padStart(11, \"0\").slice(-11);",
									"const email = \"ativa.\" + cpf + \"@exemplo.com\";",
									"pm.collectionVariables.set(\"activationCpf\", cpf);",
									"pm.collectionVariables.set(\"activationEmail\", email);",
									"pm.collectionVariables.set(\"activationToken\", \"\");",
									"pm.collectionVariables.set(\"mailpitMessageId\", \"\");",
									"pm.collectionVariables.set(\"mailpitAttempts\", \"0\");"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
									"pm.test(\"id presente\", () => pm.expect(pm.response.json().id).to.be.a(\"string\").and.not.empty);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"taxIdentifier\": \"{{activationCpf}}\",\n    \"name\": \"Ana Ativacao\",\n    \"email\": \"{{activationEmail}}\",\n    \"phone\": \"+5511998877665\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/patients",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "patients" ]
						},
						"description": "Rota pública. Grava Patient + outbox; o e-mail de ativação chega no Mailpit depois do CDC."
					}
				},
				{
					"name": "Aguardar e-mail no Mailpit",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const email = pm.collectionVariables.get(\"activationEmail\");",
									"const attempts = parseInt(pm.collectionVariables.get(\"mailpitAttempts\") || \"0\", 10);",
									"const messages = (pm.response.json() || {}).messages || [];",
									"const match = messages.find(m => (m.To || []).some(to => (to.Address || \"\").toLowerCase() === email.toLowerCase()));",
									"",
									"if (match) {",
									"  pm.test(\"mensagem encontrada\", () => pm.expect(match.ID).to.be.a(\"string\").and.not.empty);",
									"  pm.collectionVariables.set(\"mailpitMessageId\", match.ID);",
									"  pm.collectionVariables.set(\"mailpitAttempts\", \"0\");",
									"} else if (attempts < 20) {",
									"  pm.collectionVariables.set(\"mailpitAttempts\", String(attempts + 1));",
									"  postman.setNextRequest(\"Aguardar e-mail no Mailpit\");",
									"} else {",
									"  pm.test(\"e-mail chegou no Mailpit\", () => pm.expect.fail(\"timeout esperando UserActivationRequested\"));",
									"  postman.setNextRequest(null);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{mailpitUrl}}/api/v1/messages",
							"host": [ "{{mailpitUrl}}" ],
							"path": [ "api", "v1", "messages" ]
						},
						"description": "Lê a caixa do Mailpit. Se o e-mail ainda não chegou, o runner repete este request (até 20 vezes)."
					}
				},
				{
					"name": "Ler corpo do e-mail",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json() || {};",
									"const text = body.Text || body.HTML || \"\";",
									"const found = String(text).match(/activationToken=([0-9a-fA-F-]{36})/);",
									"pm.test(\"token extraído do Mailpit\", () => pm.expect(found, text).to.not.be.null);",
									"if (found) {",
									"  pm.collectionVariables.set(\"activationToken\", found[1]);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{mailpitUrl}}/api/v1/message/{{mailpitMessageId}}",
							"host": [ "{{mailpitUrl}}" ],
							"path": [ "api", "v1", "message", "{{mailpitMessageId}}" ]
						},
						"description": "Corpo do e-mail: o identity guarda só o hash; o token em claro está aqui."
					}
				},
				{
					"name": "Ativar conta",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{activationToken}}\",\n    \"password\": \"{{activationPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/activate",
							"host": [ "{{baseUrl}}" ],
							"path": [ "auth", "activate" ]
						},
						"description": "Rota pública. Define a senha; o identity guarda só o hash."
					}
				},
				{
					"name": "Login após ativação",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test(\"JWT emitido\", () => pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty);",
									"pm.test(\"tokenType Bearer\", () => pm.expect(body.tokenType).to.eql(\"Bearer\"));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "{{activationCpf}}", "type": "string" },
								{ "key": "password", "value": "{{activationPassword}}", "type": "string" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [ "{{baseUrl}}" ],
							"path": [ "auth", "login" ]
						},
						"description": "HTTP Basic com o CPF do cadastro e a senha definida na ativação."
					}
				}
			]
		},
		{
			"name": "Doctors",
			"item": [
				{
					"name": "Cadastrar médico",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{accessToken}}", "type": "string" }
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"taxIdentifier\": \"98765432100\",\n    \"crm\": \"CRM-SP 654321\",\n    \"specialty\": \"Neurologia\",\n    \"name\": \"Dr. João Mendes\",\n    \"email\": \"joao.mendes@hospital.local\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/doctors",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "doctors" ]
						},
						"description": "Exige token de um usuário com papel DOCTOR (decisão do projeto, não documentada nos ADRs). Grava o Doctor e publica DoctorRegistered na mesma transação (ADR-0012)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
									"pm.test(\"id presente\", () => pm.expect(pm.response.json().id).to.be.a(\"string\").and.not.empty);"
								]
							}
						}
					]
				}
			]
		}
	]
}
